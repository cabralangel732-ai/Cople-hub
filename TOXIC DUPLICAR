local action = Instance.new("TextButton")
action.Position = UDim2.fromOffset(15, 194)
action.Size = UDim2.new(1, -30, 0, 43)
action.BackgroundColor3 = PURPLE
action.Text = "✦  REGISTRAR PLANTA"
action.TextColor3 = WHITE
action.TextSize = 13
action.Font = Enum.Font.GothamBlack
action.Parent = main

Instance.new("UICorner", action).CornerRadius =
    UDim.new(0, 9)

local status = Instance.new("TextLabel")
status.Position = UDim2.fromOffset(15, 249)
status.Size = UDim2.new(1, -30, 0, 40)
status.BackgroundColor3 = PANEL
status.Text = "Sistema iniciado correctamente."
status.TextColor3 = Color3.fromRGB(130, 255, 180)
status.TextSize = 11
status.Font = Enum.Font.Gotham
status.TextWrapped = true
status.Parent = main

Instance.new("UICorner", status).CornerRadius =
    UDim.new(0, 8)

local registered = {}

action.Activated:Connect(function()
    local name = input.Text:match("^%s*(.-)%s*$")

    if not name or name == "" then
        status.Text = "Escribe un nombre primero."
        status.TextColor3 = Color3.fromRGB(255, 110, 130)
        return
    end

    table.insert(registered, name)

    status.Text = "Registrada: " .. name
        .. " | Total: " .. #registered
    status.TextColor3 = Color3.fromRGB(130, 255, 180)

    input.Text = ""
end)

close.Activated:Connect(function()
    main.Visible = false
end)

floating.Activated:Connect(function()
    main.Visible = not main.Visible
end)

task.spawn(function()
    while gui.Parent do
        TweenService:Create(
            stroke,
            TweenInfo.new(1),
            {Color = Color3.fromRGB(100, 35, 190)}
        ):Play()

        task.wait(1)

        if not gui.Parent then
            break
        end

        TweenService:Create(
            stroke,
            TweenInfo.new(1),
            {Color = PURPLE}
        ):Play()

        task.wait(1)
    end
end)

print("[TOXIC DUPLICATOR VIP] UI cargada.")
