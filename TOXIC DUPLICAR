Instance.new("UICorner", floating).CornerRadius =
    UDim.new(1, 0)

local floatStroke = Instance.new("UIStroke")
floatStroke.Color = PURPLE
floatStroke.Thickness = 2
floatStroke.Parent = floating

local main = Instance.new("Frame")
