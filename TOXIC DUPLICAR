local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer

if not player then
    warn("Ejecuta desde un entorno LocalScript compatible.")
    return
end

local playerGui = player:WaitForChild("PlayerGui")

local old = playerGui:FindFirstChild("ToxicDuplicatorVIP")
if old then
    old:Destroy()
end

local PURPLE = Color3.fromRGB(180, 65, 255)
local DARK = Color3.fromRGB(9, 8, 19)
local PANEL = Color3.fromRGB(20, 17, 35)
local WHITE = Color3.fromRGB(245, 240, 255)

local gui = Instance.new("ScreenGui")
