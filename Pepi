    end
end)

-- Variables de Estado
getgenv().FlyActive = false
getgenv().NoclipActive = false
getgenv().FlySpeed = 50
local bv, bg

-- Controles de Velocidad
SpeedUpBtn.MouseButton1Click:Connect(function()
    if getgenv().FlySpeed < 100 then
        getgenv().FlySpeed = getgenv().FlySpeed + 10
        SpeedLabel.Text = "VELOCIDAD: " .. getgenv().FlySpeed .. " (MAX: 100)"
    end
end)

SpeedDownBtn.MouseButton1Click:Connect(function()
    if getgenv().FlySpeed > 10 then
        getgenv().FlySpeed = getgenv().FlySpeed - 10
        SpeedLabel.Text = "VELOCIDAD: " .. getgenv().FlySpeed .. " (MAX: 100)"
    end
end)

-- Activar/Desactivar Fly
FlyBtn.MouseButton1Click:Connect(function()
    getgenv().FlyActive = not getgenv().FlyActive
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if getgenv().FlyActive then
        FlyBtn.Text = "FLY: ENCENDIDO"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        
        if humanoid then 
            humanoid.PlatformStand = true 
            local animator = humanoid:FindFirstChildOfClass("Animator")
            if animator then
                for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                    track:Stop()
                end
            end
        end

        bv = Instance.new("BodyVelocity")
        bv.Name = "HubFlyVel"
        bv.Parent = hrp
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)

        bg = Instance.new("BodyGyro")
        bg.Name = "HubFlyGyro"
        bg.Parent = hrp
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = hrp.CFrame
    else
        FlyBtn.Text = "FLY: APAGADO"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        
        if hrp:FindFirstChild("HubFlyVel") then hrp.HubFlyVel:Destroy() end
        if hrp:FindFirstChild("HubFlyGyro") then hrp.HubFlyGyro:Destroy() end
        if humanoid then humanoid.PlatformStand = false end
    end
end)

-- Activar/Desactivar Noclip (Traspasar paredes)
NoclipBtn.MouseButton1Click:Connect(function()
    getgenv().NoclipActive = not getgenv().NoclipActive
    if getgenv().NoclipActive then
        NoclipBtn.Text = "NOCLIP (PAREDES): ENCENDIDO"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
    else
        NoclipBtn.Text = "NOCLIP (PAREDES): APAGADO"
        NoclipBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    end
end)

-- Bucle de Rendimiento (Fluidez y Noclip)
RunService.Stepped:Connect(function()
    if getgenv().NoclipActive and player.Character then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().FlyActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local cam = workspace.CurrentCamera
        
        if hrp:FindFirstChild("HubFlyVel") and hrp:FindFirstChild("HubFlyGyro") then
            bg.CFrame = cam.CFrame
            
            if humanoid then
                local animator = humanoid:FindFirstChildOfClass("Animator")
                if animator then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        if track.Name == "RunAnimation" or track.Name == "WalkAnimation" then
                            track:Stop()
                        end
                    end
                end

                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    bv.Velocity = cam.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * getgenv().FlySpeed
                else
                    bv.Velocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end
end)
