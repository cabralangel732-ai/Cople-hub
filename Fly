-- Lógica para Minimizar
local minimized = false
ToggleUIBtn.MouseButton1Click:Connect(function()
    minimized = not minimized
    if minimized then
        ContentFrame.Visible = false
        MainFrame.Size = UDim2.new(0, 300, 0, 40)
        ToggleUIBtn.Text = "+"
    else
        ContentFrame.Visible = true
        MainFrame.Size = UDim2.new(0, 300, 0, 250)
        ToggleUIBtn.Text = "-"
    end
end)

-- Lógica del Vuelo Universal
getgenv().FlyActive = false

FlyBtn.MouseButton1Click:Connect(function()
    getgenv().FlyActive = not getgenv().FlyActive
    if getgenv().FlyActive then
        FlyBtn.Text = "FLY: ENCENDIDO"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        pcall(function() workspace.Gravity = 0 end)
    else
        FlyBtn.Text = "FLY: APAGADO"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        pcall(function() workspace.Gravity = 196.2 end)
    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().FlyActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        pcall(function()
            local hrp = player.Character.HumanoidRootPart
            local cam = workspace.CurrentCamera
            hrp.Velocity = cam.CFrame.LookVector * 50 + Vector3.new(0, 2, 0)
        end)
    end
end)
