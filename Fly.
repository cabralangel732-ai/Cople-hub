-- Lógica de Vuelo Real con BodyVelocity y BodyGyro
getgenv().FlyActive = false
local bv, bg

FlyBtn.MouseButton1Click:Connect(function()
    getgenv().FlyActive = not getgenv().FlyActive
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if getgenv().FlyActive then
        FlyBtn.Text = "FLY: ENCENDIDO"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(0, 255, 128)
        
        if humanoid then humanoid.PlatformStand = true end

        bv = Instance.new("BodyVelocity")
        bv.Name = "HubFlyVel"
        bv.Parent = hrp
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)

        bg = Instance.new("BodyGyro")
        bg.Name = "HubFlyGyro"
        bg.Parent = hrp
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = hrp.CFrame
    else
        FlyBtn.Text = "FLY: APAGADO"
        FlyBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        
        if hrp:FindFirstChild("HubFlyVel") then hrp.HubFlyVel:Destroy() end
        if hrp:FindFirstChild("HubFlyGyro") then hrp.HubFlyGyro:Destroy() end
        if humanoid then humanoid.PlatformStand = false end
    end
end)

RunService.RenderStepped:Connect(function()
    if getgenv().FlyActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local cam = workspace.CurrentCamera
        if hrp:FindFirstChild("HubFlyVel") and hrp:FindFirstChild("HubFlyGyro") then
            -- Vuelas exactamente hacia donde apuntas con la cámara y te mantienes suspendido
            hrp.HubFlyVel.Velocity = cam.CFrame.LookVector * 60
            hrp.HubFlyGyro.CFrame = cam.CFrame
        end
    end
end)
