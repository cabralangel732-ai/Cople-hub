    tool.Activated:Connect(function()
        local mouse = player:GetMouse()
        if mouse and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
        end
    end)
end)

RunService.Stepped:Connect(function()
    if getgenv().NoclipActive and player.Character then
        for _, part in ipairs(player.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

RunService.RenderStepped:Connect(function(dt)
    if getgenv().FlyActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        local cam = workspace.CurrentCamera
        
        if hrp:FindFirstChild("HubFlyVel") and hrp:FindFirstChild("HubFlyGyro") then
            bg.CFrame = cam.CFrame
            if humanoid then
                local moveDir = humanoid.MoveDirection
                local targetVelocity = Vector3.new(0, 0, 0)
                if moveDir.Magnitude > 0 then
                    targetVelocity = cam.CFrame:VectorToWorldSpace(Vector3.new(moveDir.X, 0, moveDir.Z)) * getgenv().FlySpeed
                end
                currentVelocity = currentVelocity:Lerp(targetVelocity, math.clamp(dt * 12, 0, 1))
                bv.Velocity = currentVelocity
            end
        end
    end
end)
