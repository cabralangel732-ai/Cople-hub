-- Función para crear botones seguros
local function makeBtn(text)
    local b = Instance.new("TextButton", Container)
    b.BackgroundColor3 = Color3.fromRGB(20, 28, 45)
    b.Size = UDim2.new(1, 0, 0, 40)
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(45, 60, 90)
    return b, s
end

local FlyBtn, FlyS = makeBtn("✈️ FLY: APAGADO")
local NoclipBtn, NoclipS = makeBtn("👻 NOCLIP: APAGADO")
local InfJumpBtn, InfJumpS = makeBtn("🦘 SALTO INFINITO: APAGADO")
local TPToolBtn = makeBtn("📍 OBTENER CLICK TP TOOL")

-- Lógica de Botones
FlyBtn.MouseButton1Click:Connect(function()
    getgenv().FlyActive = not getgenv().FlyActive
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    local humanoid = char:FindFirstChildOfClass("Humanoid")

    if getgenv().FlyActive then
        FlyBtn.Text = "✈️ FLY: ENCENDIDO"
        FlyBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        FlyS.Color = Color3.fromRGB(0, 255, 128)
        if humanoid then humanoid.PlatformStand = true end

        bv = Instance.new("BodyVelocity", hrp)
        bv.Name = "HubFlyVel"
        bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bv.Velocity = Vector3.new(0, 0, 0)

        bg = Instance.new("BodyGyro", hrp)
        bg.Name = "HubFlyGyro"
        bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bg.CFrame = hrp.CFrame
    else
        FlyBtn.Text = "✈️ FLY: APAGADO"
        FlyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        FlyS.Color = Color3.fromRGB(45, 60, 90)
        if hrp:FindFirstChild("HubFlyVel") then hrp.HubFlyVel:Destroy() end
        if hrp:FindFirstChild("HubFlyGyro") then hrp.HubFlyGyro:Destroy() end
        if humanoid then humanoid.PlatformStand = false end
    end
end)

