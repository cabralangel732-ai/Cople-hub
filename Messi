-- Lógica de encendido
FarmBtn.MouseButton1Click:Connect(function()
    getgenv().AutoFarmActive = not getgenv().AutoFarmActive
    if getgenv().AutoFarmActive then
        FarmBtn.Text = "⚡ AUTO-FARM: ENCENDIDO"
        FarmBtn.TextColor3 = Color3.fromRGB(0, 255, 128)
        FarmStroke.Color = Color3.fromRGB(0, 255, 128)
    else
        FarmBtn.Text = "⚡ AUTO-FARM: APAGADO"
        FarmBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        FarmStroke.Color = Color3.fromRGB(45, 60, 90)
    end
end)

-- Bucle de Filtro Avanzado
task.spawn(function()
    while task.wait(0.3) do
        if getgenv().AutoFarmActive and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local hrp = player.Character.HumanoidRootPart
            local targetType = getgenv().FarmTarget
            
            for _, obj in ipairs(workspace:GetDescendants()) do
                if not getgenv().AutoFarmActive then break end
                
                local name = obj.Name:lower()
                local isEgg = name:find("egg") or name:find("huevo") or name:find("nest")
                local isFood = name:find("fat") or name:find("grasa") or name:find("food")
                
                local valid = false
                if targetType == "Huevos" and isEgg then valid = true end
                if targetType == "Grasa" and isFood then valid = true end
                if targetType == "Todo" and (isEgg or isFood) then valid = true end
                
                if valid then
                    -- Si tiene interacción automática
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt") or obj.Parent:FindFirstChildWhichIsA("ProximityPrompt")
                    local targetPart = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
                    
                    if targetPart then
                        -- Solo farmear cosas dentro de un rango cercano si no quieres cruzar todo el mapa
                        hrp.CFrame = targetPart.CFrame + Vector3.new(0, 2.5, 0)
                        task.wait(0.15)
                        if prompt then
                            pcall(function() fireproximityprompt(prompt) end)
                        end
                        task.wait(0.2)
                    end
                end
            end
        end
    end
end)
