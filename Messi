-- Función para crear botones ordenados por coordenadas en cada pestaña
local function makeTabBtn(parent, posY, text)
    local b = Instance.new("TextButton", parent)
    b.BackgroundColor3 = Color3.fromRGB(20, 28, 45)
    b.Position = UDim2.new(0, 0, 0, posY)
    b.Size = UDim2.new(1, 0, 0, 42)
    b.Font = Enum.Font.GothamBold
    b.Text = text
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.TextSize = 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    local s = Instance.new("UIStroke", b)
    s.Color = Color3.fromRGB(45, 60, 90)
    return b, s
end

